#version 450

// Forward/inverse radix-2 complex FFT (f32), baseline tier.
//
// One workgroup of 256 threads per length-n transform; n active elements
// (n = power of two, 2 <= n <= 1024). Each thread strides over up to n/256
// elements via a strided loop, so a single 256-thread workgroup covers the
// whole transform regardless of n. Buffer layout is interleaved (Re, Im)
// pairs: element j lives at in[2j], in[2j+1] and out[2j], out[2j+1].
//
// pc.mode selects which slice of a buffer this workgroup transforms:
//   mode 0 (row):  workgroup w transforms the w-th contiguous run of n
//                  elements: base = w*n, stride 1. This is the 1D FFT when
//                  the dispatch is (1,1,1) and w == 0, and one row of an
//                  N x N 2D transform when dispatch is (N,1,1).
//   mode 1 (col):  workgroup w transforms the w-th strided column of an
//                  N x N 2D transform: base = w, stride = n (in place over
//                  the same buffer after the row pass).
// The kernel body is identical for both modes: bit-reversal load, shared
// memory, log2(n) radix-2 stages, strided store.
//
// Algorithm (shared-memory Cooley-Tukey DIT):
//   1. Load input into shared memory with a bit-reversal permutation.
//   2. log2(n) radix-2 butterfly stages; workgroup barrier() between stages.
//   3. Write shared memory back to the output buffer.
//
// Direction: pc.direction == 0 (VKFFT_DIR_FORWARD) uses exp(-2*pi*i*j/m)
// twiddles; pc.direction == 1 (VKFFT_DIR_INVERSE) conjugates them
// (exp(+2*pi*i*j/m)). The inverse is unnormalized (matches the rocfft
// default), so forward-then-inverse recovers the original signal scaled by n.
//
// Barrier rule: every thread in the workgroup (all 256) executes every
// barrier() the same number of times. The strided-loop trip count iters is
// derived from pc.n, which is uniform across the workgroup, so all threads
// run the same number of iterations. Memory ops are guarded by (idx < pc.n);
// barriers are kept outside any conditional.

layout(push_constant) uniform PC {
    uint n;          // FFT size (power of two, 2..1024)
    uint log2n;      // log2(n)
    uint direction;  // 0 = forward, 1 = inverse
    uint mode;       // 0 = row (stride 1), 1 = col (stride n)
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufIn  { vec2 in_data[]; };
layout(set = 0, binding = 2) writeonly           buffer BufOut { vec2 out_data[]; };

shared vec2 s[1024];

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

uint bit_reverse(uint x, uint bits) {
    uint r = 0u;
    for (uint i = 0u; i < bits; i++) {
        r = (r << 1u) | (x & 1u);
        x >>= 1u;
    }
    return r;
}

// Complex multiply: a * b with Re/Im in vec2 (.x = Re, .y = Im).
vec2 cmul(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint iters = (pc.n + 255u) / 256u;

    // Buffer slice: base = first element of the slice, stride = element step.
    // Row: base = wg*n, stride 1. Col: base = wg, stride n.
    uint base   = (pc.mode == 0u) ? gl_WorkGroupID.x * pc.n : gl_WorkGroupID.x;
    uint stride = (pc.mode == 0u) ? 1u : pc.n;

    // Load with bit-reversal permutation. s[rev] = in[base + idx*stride] for
    // idx < n (idx is the local FFT element index).
    for (uint e = 0u; e < iters; e++) {
        uint idx = tid + e * 256u;
        if (idx < pc.n) {
            s[bit_reverse(idx, pc.log2n)] = in_data[base + idx * stride];
        }
    }
    barrier();

    // Twiddle sign: forward = -2*pi*i*j/m, inverse = +2*pi*i*j/m.
    float dir = (pc.direction == 0u) ? -1.0 : 1.0;

    // log2(n) radix-2 stages. In stage m, threads whose bit (idx & half) == 0
    // form the "top" of butterfly (idx, idx|half); bottom-half threads idle
    // this stage.
    for (uint m = 2u; m <= pc.n; m <<= 1u) {
        uint hs = m >> 1u;  /* half of the stage size */
        for (uint e = 0u; e < iters; e++) {
            uint idx = tid + e * 256u;
            if ((idx < pc.n) && ((idx & hs) == 0u)) {
                uint j  = idx & (hs - 1u);
                uint lo = idx;
                uint hi = idx | hs;

                float angle = dir * 6.283185307179586 * float(j) / float(m);
                vec2  w     = vec2(cos(angle), sin(angle));

                vec2 u = s[lo];
                vec2 v = cmul(s[hi], w);

                s[lo] = u + v;
                s[hi] = u - v;
            }
        }
        barrier();
    }

    // Write result: element idx goes to out[base + idx*stride].
    for (uint e = 0u; e < iters; e++) {
        uint idx = tid + e * 256u;
        if (idx < pc.n) {
            out_data[base + idx * stride] = s[idx];
        }
    }
}
