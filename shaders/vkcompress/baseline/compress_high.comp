#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout (local_size_x = 256) in;

layout (push_constant) uniform PushConstants {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout (std430, binding = 0) restrict readonly buffer SrcBuf   { uint sdata[]; };
layout (std430, binding = 1) restrict buffer DstBuf  { uint ddata[]; };
layout (std430, binding = 2) restrict buffer MetaBuf          { uint mdata[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.num_blocks) return;

    uint src_base = tid * 256;
    uint dst_base = tid * 256;
    uint opos = dst_base;
    uint total = min(src_base + 256u, pc.num_blocks * 256u);

    while (src_base < total) {
        // LZ4-style: token[0]=literal_len, token[1]=match_dist, token[2]=match_len
        uint lit_len  = sdata[src_base];
        uint match_dist = sdata[src_base + 1u];
        uint match_len   = sdata[src_base + 2u];
        src_base += 3u;

        for (uint j = 0u; j < lit_len; j++) {
            ddata[opos++] = sdata[src_base++];
        }
        for (uint j = 0u; j < match_len; j++) {
            ddata[opos] = ddata[opos - match_dist];
            opos++;
        }
    }
    mdata[tid * 2u + 0u] = dst_base;
    mdata[tid * 2u + 1u] = opos - dst_base;
}
