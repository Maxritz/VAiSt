#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout (local_size_x = 256) in;

layout (push_constant) uniform PushConstants {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout (std430, binding = 0) restrict readonly buffer SrcBuf   { uint sdata[]; };
layout (std430, binding = 1) restrict buffer DstBuf  { uint ddata[]; };
layout (std430, binding = 2) restrict buffer MetaBuf          { uint mdata[]; };

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.num_blocks) return;

    uint comp_offset = mdata[tid * 2u + 0u];
    uint comp_words  = mdata[tid * 2u + 1u];
    uint out_base    = tid * 256u;

    uint pos = comp_offset;
    uint end = comp_offset + comp_words;
    uint opos = out_base;

    while (pos + 3u <= end) {
        uint lit_len  = sdata[pos];
        uint match_dist = sdata[pos + 1u];
        uint match_len   = sdata[pos + 2u];
        pos += 3u;

        for (uint j = 0u; j < lit_len; j++) {
            ddata[opos++] = sdata[pos++];
        }
        for (uint j = 0u; j < match_len; j++) {
            ddata[opos] = ddata[opos - match_dist];
            opos++;
        }
    }
}
