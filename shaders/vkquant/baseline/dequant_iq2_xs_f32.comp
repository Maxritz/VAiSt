    0x000000F0, 0x00000071, 0x00000072, 0x000000F3, 0x00000074, 0x000000F5, 0x000000F6, 0x00000077, 0x00000078, 0x000000F9, 0x000000FA, 0x0000007B, 0x000000FC, 0x0000007D, 0x0000007E, 0x000000FF);

void main_body(uint idx) {

    uint block = idx >> 8;
    uint lane  = idx & 255u;
    uint base  = block * 74u;
    uint ib    = lane >> 5;
    uint il    = (lane >> 3) & 3u;
    uint j     = lane & 7u;

    uint d_bits = uint(raw[base]) | (uint(raw[base + 1u]) << 8u);
    float d = unpackHalf2x16(d_bits).x;

    uint q2 = uint(raw[base + 2u + (4u * ib + il) * 2u]) |
              (uint(raw[base + 3u + (4u * ib + il) * 2u]) << 8u);

    uint sb = uint(raw[base + 66u + ib]);
    float db = d * (0.5f + float((sb >> uint(4 * int(il / 2))) & 0xFu)) * 0.25f;

    int grid_idx = int(q2 & 511u);
    uint signs = ksigns_iq2xs[q2 >> 9u];
    float gv = float(g2xs_byte(grid_idx, int(j)));
    out_f32[idx] = db * gv * ((signs & uint(kmask_iq2xs[j])) != 0u ? -1.0f : 1.0f);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.num_blocks * 256u;
    if (idx >= total) { return; }
    main_body(idx);
}
