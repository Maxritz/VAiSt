    0x00000050, 0x000000D1, 0x000000D2, 0x00000053, 0x000000D4, 0x00000055, 0x00000056, 0x000000D7, 0x000000D8, 0x00000059, 0x0000005A, 0x000000DB, 0x0000005C, 0x000000DD, 0x000000DE, 0x0000005F,
