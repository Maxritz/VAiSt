int grid_byte(int idx, int j) {
    return int((iq3xxs_grid[idx] >> uint(j * 8)) & 0xFFu);
}

const uint ksigns_iq2xs[128] = uint[](
     0, 129, 130,   3, 132,   5,   6, 135, 136,   9,  10, 139,  12, 141, 142,  15,
   144,  17,  18, 147,  20, 149, 150,  23,  24, 153, 154,  27, 156,  29,  30, 159,
   160,  33,  34, 163,  36, 165, 166,  39,  40, 169, 170,  43, 172,  45,  46, 175,
    48, 177, 178,  51, 180,  53,  54, 183, 184,  57,  58, 187,  60, 189, 190,  63,
   192,  65,  66, 195,  68, 197, 198,  71,  72, 201, 202,  75, 204,  77,  78, 207,
    80, 209, 210,  83, 212,  85,  86, 215, 216,  89,  90, 219,  92, 221, 222,  95,
    96, 225, 226,  99, 228, 101, 102, 231, 232, 105, 106, 235, 108, 237, 238, 111,
   240, 113, 114, 243, 116, 245, 246, 119, 120, 249, 250, 123, 252, 125, 126, 255);

void main_body(uint gblk) {
    uint base_in = gblk * 256u;
    uint base_out = gblk * 98u;

    float scales[8];
    uint  lout[8];
    uint  grididx[8*8];
    float xval_all[256];
    uint  bs[8*4];
    uint  aux[8];
    for (int i = 0; i < 8; ++i) aux[i] = 0u;
    for (int i = 0; i < 8*8; ++i) grididx[i] = 0u;
    for (int i = 0; i < 8*4; ++i) bs[i] = 0u;

    float max_scale = 0.0f;
    for (int ib = 0; ib < 8; ++ib) {
        float xval[32];
        uint  s[4];
        for (int k = 0; k < 4; ++k) {
            int nflip = 0; uint ss = 0u;
            for (int i = 0; i < 8; ++i) {
                float v = x[base_in + 32*ib + 8*k + i];
                if (v >= 0.0f) { xval[8*k+i] = v; }
                else { xval[8*k+i] = -v; ++nflip; ss |= (1u << i); }
            }
            if ((nflip % 2) != 0) {
                int imin = 0; float mn = 1e30f;
                for (int i = 0; i < 8; ++i) {
                    float ax = xval[8*k+i]*xval[8*k+i];
                    if (ax < mn) { mn = ax; imin = i; }
                }
                xval[8*k+imin] = -xval[8*k+imin];
                ss ^= (1u << imin);
            }
            s[k] = ss & 127u;
        }
        float mx = xval[0];
        for (int i = 1; i < 32; ++i) mx = max(mx, xval[i]);
        for (int i = 0; i < 32; ++i) xval_all[32*ib + i] = xval[i];
        if (mx < 1e-8f) {
            scales[ib] = 0.0f;
            lout[ib] = 0u;
            continue;
        }
        float best = 0.0f;
        float scale = mx / 15.0f;
        uint  best_grid[8];
        for (int k = 0; k < 8; ++k) best_grid[k] = 0u;
        for (int is = -15; is <= 15; ++is) {
            float id = (15.0f + float(is)*0.2f) / mx;
            float this_scale = 1.0f / id;
            uint gtmp[8];
            for (int k = 0; k < 8; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 256; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 4; ++i) {
                        float q = float(grid_byte(g, i)) / 4.0f;
                        float dd = this_scale * q - xval[4*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 2]);
                float q = float(grid_byte(g, i & 3)) / 4.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
                scale = sumqx / sumq2; best = scale * sumqx;
                for (int k = 0; k < 8; ++k) best_grid[k] = gtmp[k];
            }
        }
        if (scale > 0.0f) {
            uint gtmp[8];
            for (int k = 0; k < 8; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 256; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 4; ++i) {
                        float q = float(grid_byte(g, i)) / 4.0f;
                        float dd = scale * q - xval[4*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 2]);
                float q = float(grid_byte(g, i & 3)) / 4.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f) scale = sumqx / sumq2;
            for (int k = 0; k < 8; ++k) best_grid[k] = gtmp[k];
        }
        if (scale < 0.0f) {
            scale = -scale;
            for (int k = 0; k < 4; ++k) s[k] = (~s[k]) & 127u;
        }
        for (int k = 0; k < 8; ++k) grididx[8*ib + k] = best_grid[k];
        for (int k = 0; k < 4; ++k) bs[4*ib + k] = s[k];
        scales[ib] = scale;
        max_scale = max(max_scale, scale);
    }

    if (max_scale < 1e-15f) {
        for (uint i = 0u; i < 98u; ++i) obytes[base_out + i] = uint8_t(0u);
        return;
    }
    float d = (max_scale / 31.0f) * 1.0125f;
    uint dh = packHalf2x16(vec2(d, 0.0f));
    obytes[base_out] = uint8_t(dh & 0xFFu);
    obytes[base_out + 1u] = uint8_t((dh >> 8u) & 0xFFu);
    float id = 1.0f / d;
    for (int ib = 0; ib < 8; ++ib) {
        int l = nearest_int(0.5f * (id * scales[ib] - 1.0f));
        l = clamp(l, 0, 15);
        lout[ib] = uint(l);
        aux[ib] = bs[4*ib] | (bs[4*ib+1] << 7u) | (bs[4*ib+2] << 14u) | (bs[4*ib+3] << 21u) | (uint(l) << 28u);
    }
    // final requantize of grid indices against the quantized db
    for (int ib = 0; ib < 8; ++ib) {
        float db = d * (0.5f + float(lout[ib])) * 0.5f;
        if (db == 0.0f) continue;
        for (int k = 0; k < 8; ++k) {
            int bg = -1; float berr = 1e30f;
            for (int g = 0; g < 256; ++g) {
                float err = 0.0f;
                for (int i = 0; i < 4; ++i) {
                    float q = float(grid_byte(g, i));
                    float dd = db * q - xval_all[32*ib + 4*k + i];
                    err += dd * dd;
                }
                if (err < berr) { berr = err; bg = g; }
            }
            grididx[8*ib + k] = uint(bg);
        }
    }
    for (int ib = 0; ib < 8; ++ib) {
        for (int k = 0; k < 8; ++k) {
            obytes[base_out + 2u + uint(8*ib + k)] = uint8_t(grididx[8*ib + k] & 0xFFu);
        }
        for (uint j = 0u; j < 4u; ++j) {
            obytes[base_out + 66u + uint(4*ib) + j] = uint8_t((aux[ib] >> (8u*j)) & 0xFFu);
        }
    }
}
void main() {
    uint gblk = gl_WorkGroupID.x;
    if (gblk >= pc.num_blocks) { return; }
    main_body(gblk);
}
