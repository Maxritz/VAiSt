int grid_byte(int idx, int j) {
    uint w = (j < 4) ? g2xxs_lo[idx] : g2xxs_hi[idx];
    uint sh = (j < 4) ? uint(j * 8) : uint((j - 4) * 8);
    return int((w >> sh) & 0xFFu);
}

void main_body(uint gblk) {
    uint base_in = gblk * 256u;
    uint base_out = gblk * 66u;

    float scales[8];
    uint  lout[8];
    uint  q2[16];
    float xval_all[256];
    for (int i = 0; i < 16; ++i) q2[i] = 0u;

    float max_scale = 0.0f;
    for (int ib = 0; ib < 8; ++ib) {
        float xval[32];
        uint  bs[4];
        for (int k = 0; k < 4; ++k) {
            int nflip = 0; uint s = 0u;
            for (int i = 0; i < 8; ++i) {
                float v = x[base_in + 32*ib + 8*k + i];
                if (v >= 0.0f) { xval[8*k+i] = v; }
                else { xval[8*k+i] = -v; ++nflip; s |= (1u << i); }
            }
            if ((nflip % 2) != 0) {
                int imin = 0; float mn = 1e30f;
                for (int i = 0; i < 8; ++i) {
                    float ax = xval[8*k+i]*xval[8*k+i];
                    if (ax < mn) { mn = ax; imin = i; }
                }
                xval[8*k+imin] = -xval[8*k+imin];
                s ^= (1u << imin);
            }
            bs[k] = s & 127u;
        }
        float mx = xval[0];
        for (int i = 1; i < 32; ++i) mx = max(mx, xval[i]);
        for (int i = 0; i < 32; ++i) xval_all[32*ib + i] = xval[i];
        if (mx < 1e-15f) {
            scales[ib] = 0.0f;
            lout[ib] = 0u;
            continue;
        }
        float best = 0.0f;
        float scale = mx / 5.0f;
        uint  best_grid[4];
        for (int k = 0; k < 4; ++k) best_grid[k] = 0u;
        for (int is = -6; is <= 6; ++is) {
            float id = (5.0f + float(is)*0.1f) / mx;
            float this_scale = 1.0f / id;
            uint gtmp[4];
            for (int k = 0; k < 4; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 256; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 8; ++i) {
                        float q = float(grid_byte(g, i)) / 8.0f;
                        float dd = this_scale * q - xval[8*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 3]);
                float q = float(grid_byte(g, i & 7)) / 8.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
                scale = sumqx / sumq2; best = scale * sumqx;
                for (int k = 0; k < 4; ++k) best_grid[k] = gtmp[k];
            }
        }
        if (scale > 0.0f) {
            uint gtmp[4];
            for (int k = 0; k < 4; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 256; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 8; ++i) {
                        float q = float(grid_byte(g, i)) / 8.0f;
                        float dd = scale * q - xval[8*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 3]);
                float q = float(grid_byte(g, i & 7)) / 8.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f) scale = sumqx / sumq2;
            for (int k = 0; k < 4; ++k) best_grid[k] = gtmp[k];
        }
        if (scale < 0.0f) {
            scale = -scale;
            for (int k = 0; k < 4; ++k) bs[k] = (~bs[k]) & 127u;
        }
        for (int k = 0; k < 4; ++k) {
            q2[2*ib]     |= (best_grid[k] & 0xFFu) << (8u * uint(k));
            q2[2*ib + 1] |= (bs[k] & 0x7Fu) << (7u * uint(k));
        }
        scales[ib] = scale;
        max_scale = max(max_scale, scale);
    }

    if (max_scale < 1e-15f) {
        for (uint i = 0u; i < 66u; ++i) obytes[base_out + i] = uint8_t(0u);
        return;
    }
    float d = max_scale / 31.0f;
    uint dh = packHalf2x16(vec2(d, 0.0f));
    obytes[base_out] = uint8_t(dh & 0xFFu);
    obytes[base_out + 1u] = uint8_t((dh >> 8u) & 0xFFu);
    float id = 1.0f / d;
    for (int ib = 0; ib < 8; ++ib) {
        int l = nearest_int(0.5f * (id * scales[ib] - 1.0f));
        l = clamp(l, 0, 15);
        lout[ib] = uint(l);
        q2[2*ib + 1] |= (uint(l) & 0xFu) << 28u;
    }
    // final requantize of grid indices against the quantized db
    for (int ib = 0; ib < 8; ++ib) {
        float db = d * (0.5f + float(lout[ib])) * 0.25f;
        if (db == 0.0f) continue;
        for (int k = 0; k < 4; ++k) {
            int bg = -1; float berr = 1e30f;
            for (int g = 0; g < 256; ++g) {
                float err = 0.0f;
                for (int i = 0; i < 8; ++i) {
                    float q = float(grid_byte(g, i));
                    float dd = db * q - xval_all[32*ib + 8*k + i];
                    err += dd * dd;
                }
                if (err < berr) { berr = err; bg = g; }
            }
            q2[2*ib] &= ~(0xFFu << (8u * uint(k)));
            q2[2*ib] |= (uint(bg) & 0xFFu) << (8u * uint(k));
        }
    }
    for (int ib = 0; ib < 8; ++ib) {
        for (uint j = 0u; j < 4u; ++j) {
            obytes[base_out + 2u + uint(8*ib) + j]     = uint8_t((q2[2*ib]   >> (8u*j)) & 0xFFu);
            obytes[base_out + 6u + uint(8*ib) + j]     = uint8_t((q2[2*ib+1] >> (8u*j)) & 0xFFu);
        }
    }
}
void main() {
    uint gblk = gl_WorkGroupID.x;
    if (gblk >= pc.num_blocks) { return; }
    main_body(gblk);
}
