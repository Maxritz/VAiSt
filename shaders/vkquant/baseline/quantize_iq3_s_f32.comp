int grid_byte(int idx, int j) {
    return int((iq3s_grid[idx] >> uint(j * 8)) & 0xFFu);
}

void main_body(uint gblk) {
    uint base_in = gblk * 256u;
    uint base_out = gblk * 110u;

    float scales[8];
    uint  lout[8];
    uint  grididx[8*8];
    float xval_all[256];
    uint  signs8[8*4];
    uint8_t scales_bytes[4];
    for (int i = 0; i < 8*8; ++i) grididx[i] = 0u;
    for (int i = 0; i < 8*4; ++i) signs8[i] = 0u;
    for (int i = 0; i < 4; ++i) scales_bytes[i] = uint8_t(0u);

    float max_scale = 0.0f;
    for (int ib = 0; ib < 8; ++ib) {
        float xval[32];
        uint  s[4];
        for (int k = 0; k < 4; ++k) {
            uint ss = 0u;
            for (int i = 0; i < 8; ++i) {
                float v = x[base_in + 32*ib + 8*k + i];
                if (v >= 0.0f) { xval[8*k+i] = v; }
                else { xval[8*k+i] = -v; ss |= (1u << i); }
            }
            s[k] = ss;
        }
        float mx = xval[0];
        for (int i = 1; i < 32; ++i) mx = max(mx, xval[i]);
        for (int i = 0; i < 32; ++i) xval_all[32*ib + i] = xval[i];
        if (mx < 1e-8f) {
            scales[ib] = 0.0f;
            lout[ib] = 0u;
            continue;
        }
        float best = 0.0f;
        float scale = mx / 15.0f;
        uint  best_grid[8];
        for (int k = 0; k < 8; ++k) best_grid[k] = 0u;
        for (int is = -9; is <= 9; ++is) {
            float id = (15.0f + float(is)*0.2f) / mx;
            float this_scale = 1.0f / id;
            uint gtmp[8];
            for (int k = 0; k < 8; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 512; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 4; ++i) {
                        float q = float(grid_byte(g, i));
                        float dd = this_scale * q - xval[4*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 2]);
                float q = float(grid_byte(g, i & 3));
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
                scale = sumqx / sumq2; best = scale * sumqx;
                for (int k = 0; k < 8; ++k) best_grid[k] = gtmp[k];
            }
        }
        if (scale > 0.0f) {
            uint gtmp[8];
            for (int k = 0; k < 8; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 512; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 4; ++i) {
                        float q = float(grid_byte(g, i));
                        float dd = scale * q - xval[4*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 32; ++i) {
                int g = int(gtmp[i >> 2]);
                float q = float(grid_byte(g, i & 3));
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f) scale = sumqx / sumq2;
            for (int k = 0; k < 8; ++k) best_grid[k] = gtmp[k];
        }
        if (scale < 0.0f) {
            scale = -scale;
            for (int k = 0; k < 4; ++k) s[k] = ~s[k];
        }
        for (int k = 0; k < 8; ++k) grididx[8*ib + k] = best_grid[k];
        for (int k = 0; k < 4; ++k) signs8[4*ib + k] = s[k];
        scales[ib] = scale;
        max_scale = max(max_scale, scale);
    }

    if (max_scale < 1e-15f) {
        for (uint i = 0u; i < 110u; ++i) obytes[base_out + i] = uint8_t(0u);
        return;
    }
    float d = (max_scale / 31.0f) * 1.033f;
    uint dh = packHalf2x16(vec2(d, 0.0f));
    obytes[base_out] = uint8_t(dh & 0xFFu);
    obytes[base_out + 1u] = uint8_t((dh >> 8u) & 0xFFu);
    float id = 1.0f / d;
    for (int ib = 0; ib < 8; ++ib) {
        int l = nearest_int(0.5f * (id * scales[ib] - 1.0f));
        l = clamp(l, 0, 15);
        lout[ib] = uint(l);
        if (ib % 2 == 0) scales_bytes[ib/2] = uint8_t(l & 0xF);
        else scales_bytes[ib/2] |= uint8_t((l & 0xF) << 4);
    }
    // final requantize of grid indices against the quantized db
    for (int ib = 0; ib < 8; ++ib) {
        float db = d * (1.0f + 2.0f * float(lout[ib]));
        if (db == 0.0f) continue;
        for (int k = 0; k < 8; ++k) {
            int bg = -1; float berr = 1e30f;
            for (int g = 0; g < 512; ++g) {
                float err = 0.0f;
                for (int i = 0; i < 4; ++i) {
                    float q = float(grid_byte(g, i));
                    float dd = db * q - xval_all[32*ib + 4*k + i];
                    err += dd * dd;
                }
                if (err < berr) { berr = err; bg = g; }
            }
            grididx[8*ib + k] = uint(bg);
        }
    }
    for (int ib = 0; ib < 8; ++ib) {
        for (int k = 0; k < 8; ++k) {
            obytes[base_out + 2u + uint(8*ib + k)] = uint8_t(grididx[8*ib + k] & 0xFFu);
        }
        uint qh = 0u;
        for (int k = 0; k < 8; ++k) qh |= ((grididx[8*ib + k] >> 8u) & 1u) << uint(k);
        obytes[base_out + 66u + uint(ib)] = uint8_t(qh);
        for (int k = 0; k < 4; ++k) {
            obytes[base_out + 74u + uint(4*ib + k)] = uint8_t(signs8[4*ib + k] & 0xFFu);
        }
    }
    for (int i = 0; i < 4; ++i) obytes[base_out + 106u + uint(i)] = scales_bytes[i];
}
void main() {
    uint gblk = gl_WorkGroupID.x;
    if (gblk >= pc.num_blocks) { return; }
    main_body(gblk);
}
