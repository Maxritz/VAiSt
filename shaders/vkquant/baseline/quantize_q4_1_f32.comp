#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Forward quantization f32 -> Q4_1 (ggml block_q4_1, 20 bytes/block, 32 elems).
// ggml quantize_row_q4_1_ref scale selection (min/max, 4-bit levels):
//   d = (max - min) / 15;  m = min;  level = (x - min) * id clamped [0,15]
//   out = d*level + m round-trips.
// One workgroup of 1 thread handles one block (transliteration of the ref).

layout(push_constant) uniform PC {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufIn {
    float x[];
};
layout(scalar, set = 0, binding = 2) writeonly buffer BufOut {
    uint8_t obytes[];
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

shared float sx[32];
shared int   sq[32];

void main() {
    uint gblk = gl_WorkGroupID.x;
    uint base_in = gblk * 32u;
    uint base_out = gblk * 20u;

    for (uint i = 0u; i < 32u; ++i) {
        sx[i] = (gblk < pc.num_blocks) ? x[base_in + i] : 0.0f;
    }

    float mn = sx[0];
    float mx = sx[0];
    for (uint i = 1u; i < 32u; ++i) {
        mn = min(mn, sx[i]);
        mx = max(mx, sx[i]);
    }

    float d  = (mx - mn) / 15.0f;
    float id = (d != 0.0f) ? (1.0f / d) : 0.0f;

    for (uint j = 0u; j < 16u; ++j) {
        float x0 = (sx[j]      - mn) * id;
        float x1 = (sx[j + 16u] - mn) * id;
        int xi0 = min(15, int(x0 + 0.5f));
        int xi1 = min(15, int(x1 + 0.5f));
        obytes[base_out + 4u + j] = uint8_t(uint(xi0 & 0xF) | uint((xi1 & 0xF) << 4));
    }

    uint dh = packHalf2x16(vec2(d, 0.0f));
    uint mh = packHalf2x16(vec2(mn, 0.0f));
    obytes[base_out + 0u] = uint8_t(dh & 0xFFu);
    obytes[base_out + 1u] = uint8_t((dh >> 8u) & 0xFFu);
    obytes[base_out + 2u] = uint8_t(mh & 0xFFu);
    obytes[base_out + 3u] = uint8_t((mh >> 8u) & 0xFFu);
}
