        if (mx < 1e-8f) {
            scales[ib] = 0.0f;
            lout[ib] = 0u;
            continue;
        }
        float best = 0.0f;
        float scale = mx / 5.0f;
        uint  best_grid[2];
        for (int k = 0; k < 2; ++k) best_grid[k] = 0u;
        for (int is = -9; is <= 9; ++is) {
            float id = (5.0f + float(is)*0.1f) / mx;
            float this_scale = 1.0f / id;
            uint gtmp[2];
            for (int k = 0; k < 2; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 1024; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 8; ++i) {
                        float q = float(grid_byte(g, i)) / 8.0f;
                        float dd = this_scale * q - xval[8*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 16; ++i) {
                int g = int(gtmp[i >> 3]);
                float q = float(grid_byte(g, i & 7)) / 8.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f && sumqx*sumqx > best*sumq2) {
                scale = sumqx / sumq2; best = scale * sumqx;
                for (int k = 0; k < 2; ++k) best_grid[k] = gtmp[k];
            }
        }
        if (scale > 0.0f) {
            uint gtmp[2];
            for (int k = 0; k < 2; ++k) {
                int bg = -1; float berr = 1e30f;
                for (int g = 0; g < 1024; ++g) {
                    float err = 0.0f;
                    for (int i = 0; i < 8; ++i) {
                        float q = float(grid_byte(g, i)) / 8.0f;
                        float dd = scale * q - xval[8*k+i];
                        err += dd * dd;
                    }
                    if (err < berr) { berr = err; bg = g; }
                }
                gtmp[k] = uint(bg);
            }
            float sumqx = 0.0f, sumq2 = 0.0f;
            for (int i = 0; i < 16; ++i) {
                int g = int(gtmp[i >> 3]);
                float q = float(grid_byte(g, i & 7)) / 8.0f;
                sumqx += xval[i] * q;
                sumq2 += q * q;
            }
            if (sumq2 > 0.0f) scale = sumqx / sumq2;
            for (int k = 0; k < 2; ++k) best_grid[k] = gtmp[k];
        }
        if (scale < 0.0f) {
            scale = -scale;
            for (int k = 0; k < 2; ++k) bs[k] = ~bs[k];
        }
        for (int k = 0; k < 2; ++k) {
            int i8 = 2*ib + k;
            qs_lo[i8] = best_grid[k] & 0xFFu;
            qh_bits[i8] = (best_grid[k] >> 8u) & 0x3u;
            signs[i8] = bs[k] & 0xFFu;
        }
        scales[ib] = scale;
        max_scale = max(max_scale, scale);
    }

    if (max_scale < 1e-15f) {
        for (uint i = 0u; i < 82u; ++i) obytes[base_out + i] = uint8_t(0u);
        return;
    }
    float d = (max_scale / 31.0f) * 0.9875f;
    uint dh = packHalf2x16(vec2(d, 0.0f));
    obytes[base_out] = uint8_t(dh & 0xFFu);
    obytes[base_out + 1u] = uint8_t((dh >> 8u) & 0xFFu);
    float id = 1.0f / d;
    for (int ib = 0; ib < 16; ++ib) {
        int l = nearest_int(0.5f * (id * scales[ib] - 1.0f));
        l = clamp(l, 0, 15);
        lout[ib] = uint(l);
        if (ib % 2 == 0) scales_bytes[ib/2] = uint8_t(l & 0xF);
        else scales_bytes[ib/2] |= uint8_t((l & 0xF) << 4);
    }
    for (int ib = 0; ib < 16; ++ib) {
        float db = d * (0.5f + float(lout[ib])) * 0.25f;
        if (db == 0.0f) continue;
        for (int k = 0; k < 2; ++k) {
            int bg = -1; float berr = 1e30f;
            for (int g = 0; g < 1024; ++g) {
                float err = 0.0f;
                for (int i = 0; i < 8; ++i) {
                    float q = float(grid_byte(g, i));
                    float dd = db * q - xval_all[16*ib + 8*k + i];
                    err += dd * dd;
                }
                if (err < berr) { berr = err; bg = g; }
            }
            int i8 = 2*ib + k;
            qs_lo[i8] = uint(bg) & 0xFFu;
            qh_bits[i8] = (uint(bg) >> 8u) & 0x3u;
        }
    }
    for (int ib = 0; ib < 16; ++ib) {
        for (int k = 0; k < 2; ++k) {
            int i8 = 2*ib + k;
            obytes[base_out + 2u + uint(i8)] = uint8_t(qs_lo[i8]);
            obytes[base_out + 32u + uint(i8)] = uint8_t(signs[i8]);
        }
        // qh byte for 32-group ib/2: bits (2*((2*ib+k)%4), +1) for k=0,1
        uint qh = 0u;
        for (int k = 0; k < 2; ++k) {
            int i8 = 2*ib + k;
            uint pos = uint((i8 % 4) * 2);
            qh |= (qh_bits[i8] & 0x3u) << pos;
        }
        obytes[base_out + 66u + uint(ib/2)] |= uint8_t(qh);
    }
    for (int i = 0; i < 8; ++i) obytes[base_out + 74u + uint(i)] = scales_bytes[i];
}
void main() {
    uint gblk = gl_WorkGroupID.x;
    if (gblk >= pc.num_blocks) { return; }
    main_body(gblk);
}
