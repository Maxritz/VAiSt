#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Forward quantization f32 -> Q3_K (ggml block_q3_K, 110 bytes/block, 256 elems).
// ggml quantize_row_q3_K_ref scale selection (make_q3_quants per 16-group,
// signed levels -4..3) + 12-byte 6-bit scale packing + hmask bit plane.
// Bytes round-trip through dequant_q3k_f32 (out = d*(sc-32)*((q&3) - hmbit)).
// One workgroup of 1 thread handles one block (transliteration of the ref).

layout(push_constant) uniform PC {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufIn {
    float x[];
};
layout(scalar, set = 0, binding = 2) writeonly buffer BufOut {
    uint8_t obytes[];
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

shared float sx[256];
shared int   sL[256];
shared float ssc[16];
shared int   ssb[12];
shared int   ssm[32];

void main() {
    uint gblk = gl_WorkGroupID.x;
    uint base_in = gblk * 256u;
    uint base_out = gblk * 110u;

    for (uint i = 0u; i < 256u; ++i) {
        sx[i] = (gblk < pc.num_blocks) ? x[base_in + i] : 0.0f;
        sL[i] = 0;
    }
    for (int i = 0; i < 12; ++i) ssb[i] = 0;
    for (int i = 0; i < 32; ++i) ssm[i] = 0;

    float max_scale = 0.0f;
    for (int j = 0; j < 16; ++j) {
        float amax = 0.0f;
        float mx = 0.0f;
        for (int i = 0; i < 16; ++i) {
            float av = abs(sx[j * 16 + i]);
            if (av > amax) { amax = av; mx = sx[j * 16 + i]; }
        }
        float scale;
        if (amax < 1e-5f) {
            scale = 0.0f;
        } else {
            float iscale = -4.0f / mx;
            for (int i = 0; i < 16; ++i) {
                int l = clamp(int(round(iscale * sx[j * 16 + i])), -4, 3);
                sL[j * 16 + i] = l + 4;
            }
            scale = 1.0f / iscale;
        }
        ssc[j] = scale;
        if (abs(scale) > abs(max_scale)) max_scale = scale;
    }

    float d = 0.0f;
    if (max_scale != 0.0f) {
        float iscale = -32.0f / max_scale;
        for (int j = 0; j < 16; ++j) {
            int l = clamp(int(round(iscale * ssc[j])), -32, 31) + 32;  /* 0..63 */
            if (j < 8) {
                ssb[j] = l & 0xF;
            } else {
                ssb[j - 8] |= ((l & 0xF) << 4);
            }
            l >>= 4;
            ssb[(j % 4) + 8] |= (l << (2 * (j / 4)));
        }
        d = 1.0f / iscale;
    }

    float d_f16 = unpackHalf2x16(packHalf2x16(vec2(d, 0.0f))).x;

    for (int j = 0; j < 16; ++j) {
        int sc = (j < 8) ? (ssb[j] & 0xF) : (ssb[j - 8] >> 4);
        sc = (sc | (((ssb[8 + j % 4] >> (2 * (j / 4))) & 3) << 4)) - 32;
        float dg = d_f16 * float(sc);
        if (dg == 0.0f) continue;
        for (int ii = 0; ii < 16; ++ii) {
            int l = clamp(int(round(sx[j * 16 + ii] / dg)), -4, 3);
            sL[j * 16 + ii] = l + 4;
        }
    }

    for (int j = 0; j < 256; ++j) {
        if (sL[j] > 3) {
            ssm[j & 31] |= (1 << (j >> 5));
            sL[j] -= 4;
        }
    }

    for (int j = 0; j < 256; j += 128) {
        for (int l = 0; l < 32; ++l) {
            uint b = uint(j / 4 + l);
            obytes[base_out + 32u + b] =
                uint8_t(uint(sL[j + l] & 0x3) |
                        uint((sL[j + l + 32] & 0x3) << 2) |
                        uint((sL[j + l + 64] & 0x3) << 4) |
                        uint((sL[j + l + 96] & 0x3) << 6));
        }
    }

    for (int i = 0; i < 32; ++i) obytes[base_out + uint(i)] = uint8_t(ssm[i] & 0xFF);
    for (int i = 0; i < 12; ++i) obytes[base_out + 96u + uint(i)] = uint8_t(ssb[i] & 0xFF);

    uint dh = packHalf2x16(vec2(d, 0.0f));
    obytes[base_out + 108u] = uint8_t(dh & 0xFFu);
    obytes[base_out + 109u] = uint8_t((dh >> 8u) & 0xFFu);
}
