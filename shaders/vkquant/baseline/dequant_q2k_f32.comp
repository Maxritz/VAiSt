#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q2_K block dequantization to f32 (ggml block_q2_K, 84 bytes/block, 256 elems).
// Layout: uint8_t scales[16] @0, uint8_t qs[64] @16, ggml_half d @80,
//         ggml_half dmin @82.
// Dequant (canonical ggml dequantize_row_q2_K):
//   is = 0
//   for n in {0,128}:  q = qs + n/4 ... (offset n*? per n -> qs[n/4*32?])
//     shift = 0
//     for j in 0..3:
//       sc = scales[is];   dl = d*(sc&0xF);   ml = min*(sc>>4)
//       for l in 0..15: y[n + j*32 + l]     = dl*((q[l]    >> shift)&3) - ml
//       is++
//       sc = scales[is];   dl = d*(sc&0xF);   ml = min*(sc>>4)
//       for l in 0..15: y[n + j*32 + 16 + l] = dl*((q[l+16] >> shift)&3) - ml
//       is++; shift += 2
//     q += 32
//   (byte q index for element idx: n*32 + sub*16 + l where n = idx>>7,
//    sub = (idx>>4)&1, l = idx&15; shift = 2*( (idx>>5)&3 ))
// One thread per output element; block = idx >> 8, lane = idx & 255.

layout(push_constant) uniform PC {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufIn {
    uint8_t raw[];
};
layout(scalar, set = 0, binding = 2) writeonly buffer BufOut {
    float out_f32[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.num_blocks * 256u;
    if (idx >= total) { return; }

    uint block = idx >> 8;
    uint lane  = idx & 255u;
    uint base  = block * 84u;

    uint d_bits = uint(raw[base + 80u]) | (uint(raw[base + 81u]) << 8u);
    uint m_bits = uint(raw[base + 82u]) | (uint(raw[base + 83u]) << 8u);
    float d  = unpackHalf2x16(d_bits).x;
    float dm = unpackHalf2x16(m_bits).x;

    uint n   = lane >> 7;
    uint j   = (lane >> 5) & 3u;
    uint sub = (lane >> 4) & 1u;
    uint l   = lane & 15u;

    uint is  = n * 8u + j * 2u + sub;
    uint sc  = uint(raw[base + is]);
    float dl = d * float(sc & 0xFu);
    float ml = dm * float(sc >> 4u);

    uint qbyte = uint(raw[base + 16u + n * 32u + l + sub * 16u]);
    uint level = (qbyte >> (j * 2u)) & 3u;

    out_f32[idx] = dl * float(level) - ml;
}
