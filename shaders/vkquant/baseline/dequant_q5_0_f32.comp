#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Q5_0 block dequantization to f32 (ggml block_q5_0, 22 bytes/block).
// Layout: ggml_half d (2B LE) @0, uint8_t qh[4] @2, uint8_t qs[16] @6.
// Dequant (canonical ggml dequantize_row_q5_0), QK5_0 = 32:
//   xh_0 = ((qh >> (j + 0)) << 4) & 0x10
//   xh_1 = ((qh >> (j + 12))    ) & 0x10
//   x0 = ((qs[j] & 0x0F) | xh_0) - 16   -> y[j]
//   x1 = ((qs[j] >>   4) | xh_1) - 16   -> y[j+16]
//   y = x*d
// One thread per output element; block = idx >> 5, lane = idx & 31.

layout(push_constant) uniform PC {
    uint num_blocks;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufIn {
    uint8_t raw[];
};
layout(scalar, set = 0, binding = 2) writeonly buffer BufOut {
    float out_f32[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.num_blocks * 32u;
    if (idx >= total) { return; }

    uint block = idx >> 5;
    uint lane  = idx & 31u;
    uint base  = block * 22u;

    uint d_bits = uint(raw[base]) | (uint(raw[base + 1u]) << 8u);
    float d = unpackHalf2x16(d_bits).x;

    uint qh = uint(raw[base + 2u]) | (uint(raw[base + 3u]) << 8u) |
              (uint(raw[base + 4u]) << 16u) | (uint(raw[base + 5u]) << 24u);

    uint j = lane & 15u;
    uint qbyte = uint(raw[base + 6u + j]);

    uint v;
    if (lane < 16u) {
        uint xh_0 = ((qh >> (j + 0u)) << 4u) & 0x10u;
        v = (qbyte & 0xFu) | xh_0;
    } else {
        uint xh_1 = ((qh >> (j + 12u))      ) & 0x10u;
        v = (qbyte >> 4u) | xh_1;
    }

    out_f32[idx] = d * (float(int(v)) - 16.0f);
}
