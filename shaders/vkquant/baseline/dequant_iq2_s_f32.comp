const int kmask_iq2xs[8] = int[](1, 2, 4, 8, 16, 32, 64, 128);

void main_body(uint idx) {

    uint block = idx >> 8;
    uint lane  = idx & 255u;
    uint base  = block * 82u;
    uint ib    = lane >> 5;
    uint il    = (lane >> 3) & 3u;
    uint j     = lane & 7u;

    uint d_bits = uint(raw[base]) | (uint(raw[base + 1u]) << 8u);
    float d = unpackHalf2x16(d_bits).x;

    uint sb = uint(raw[base + 74u + ib]);
    float db = d * (0.5f + float((sb >> uint(4 * int(il / 2))) & 0xFu)) * 0.25f;

    uint qb = uint(raw[base + 2u + 4u * ib + il]);
    uint qh = uint(raw[base + 66u + ib]);
    uint grid_idx = qb | ((qh << uint(8 - 2 * int(il))) & 0x300u);
    uint signs = uint(raw[base + 2u + 32u + 4u * ib + il]);

    float gv = float(g2s_byte(int(grid_idx), int(j)));
    out_f32[idx] = db * gv * ((signs & uint(kmask_iq2xs[j])) != 0u ? -1.0f : 1.0f);
}

