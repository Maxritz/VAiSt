#version 450
#extension GL_ARB_gpu_shader_int64 : require

// Specialization constants
layout(constant_id = 0) const uint TILE_M = 16;
layout(constant_id = 1) const uint TILE_N = 16;
layout(constant_id = 2) const uint TILE_K = 16;

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    int64_t strideA;
    int64_t strideB;
    int64_t strideC;
    int64_t strideD;
    int64_t batchCount;
    int64_t _pad1;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

shared float As[TILE_M * TILE_K];
shared float Bs[TILE_K * TILE_N];

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uint row = gl_LocalInvocationID.x;
    uint col = gl_LocalInvocationID.y;

    uint grRow = gl_WorkGroupID.x;
    uint grCol = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;

    uint globalRow = grRow * TILE_M + row;
    uint globalCol = grCol * TILE_N + col;

    float acc = 0.0;
    uint numTiles = (pc.k + TILE_K - 1) / TILE_K;

    for (uint t = 0; t < numTiles; ++t) {
        // ── Load A tile (TILE_M rows × TILE_K cols) ─────────────────────
        // Thread [row, col] loads As[row, a_col] for a_col = col, col+TILE_N, ...
        for (uint a_col = col; a_col < TILE_K; a_col += TILE_N) {
            uint aRow, aCol;
            if (pc.transA == 0) {
                aRow = globalRow;
                aCol = t * TILE_K + a_col;
            } else {
                aRow = t * TILE_K + a_col;
                aCol = globalRow;
            }
            uint64_t idx = uint64_t(aRow) + uint64_t(aCol) * uint64_t(pc.lda) + uint64_t(batch) * uint64_t(pc.strideA);
            As[row * TILE_K + a_col] = data_A[idx];
        }

        // ── Load B tile (TILE_K rows × TILE_N cols) ─────────────────────
        for (uint b_row = row; b_row < TILE_K; b_row += TILE_M) {
            uint bRow, bCol;
            if (pc.transB == 0) {
                bRow = t * TILE_K + b_row;
                bCol = globalCol;
            } else {
                bRow = globalCol;
                bCol = t * TILE_K + b_row;
            }
            uint64_t idx = uint64_t(bRow) + uint64_t(bCol) * uint64_t(pc.ldb) + uint64_t(batch) * uint64_t(pc.strideB);
            Bs[b_row * TILE_N + col] = data_B[idx];
        }

        barrier();

        // ── Compute: acc += sum_k As[row, kk] * Bs[kk, col] ──────────────
        for (uint kk = 0; kk < TILE_K; ++kk) {
            acc += As[row * TILE_K + kk] * Bs[kk * TILE_N + col];
        }

        barrier();
    }

    // ── Scale and write ──────────────────────────────────────────────────
    float result = pc.alpha * acc;

    if (pc.beta_is_zero == 0) {
        uint64_t cIdx = uint64_t(globalRow) + uint64_t(globalCol) * uint64_t(pc.ldc) + uint64_t(batch) * uint64_t(pc.strideC);
        result += pc.beta * data_C[cIdx];
    }

    uint64_t dIdx = uint64_t(globalRow) + uint64_t(globalCol) * uint64_t(pc.ldd) + uint64_t(batch) * uint64_t(pc.strideD);
    data_D[dIdx] = result;
}
