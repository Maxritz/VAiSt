#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_float16 : enable
#extension GL_EXT_scalar_block_layout : enable

/**
 * \file symv_f16.comp
 * \brief f16 variant of symv: y = alpha * A * x + beta * y, f16 storage, f32 compute.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufA { float16_t data_A[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufB { float16_t data_B[]; };
layout(scalar, set = 0, binding = 2) restrict readonly buffer BufC { float16_t data_C[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufD { float16_t data_D[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint n     = pc.m;
    const uint i     = gl_GlobalInvocationID.x;
    const uint batch = gl_GlobalInvocationID.y;
    if (i >= n) return;
    const bool readLower = (pc.transB == 0);
    const uint aOff = batch * pc.strideA;
    const uint xOff = batch * pc.strideB;
    const uint yOff = batch * pc.strideC;
    const uint dOff = batch * pc.strideD;

    float acc = 0.0;
    for (uint j = 0; j < n; ++j) {
        float a_ij;
        if (readLower)
            a_ij = (i >= j) ? float(data_A[aOff + i + j * pc.lda])
                            : float(data_A[aOff + j + i * pc.lda]);
        else
            a_ij = (j >= i) ? float(data_A[aOff + i + j * pc.lda])
                            : float(data_A[aOff + j + i * pc.lda]);
        acc += a_ij * float(data_B[xOff + j]);
    }
    float y_i = (pc.beta_is_zero == 1) ? 0.0 : float(data_C[yOff + i]);
    data_D[dOff + i] = float16_t(pc.alpha * acc + pc.beta * y_i);
}
