#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Fused quantized GEMM: y = alpha * (dequant_q3k(W) * x) + beta * y.
//
// W is the weight matrix (pc.m rows x k cols), stored row-wise as ggml
// Q3_K blocks of 256 elements (110 bytes each). Row r's blocks start at
// byte offset r * pc.lda; block b covers k-elements [256b, 256b+256) at
// byte offset b*110 within the row.
//
// Block layout (canonical ggml block_q3_K):
//   bytes   0..31    uint8_t hmask[32] (high/sign bits)
//   bytes  32..95    uint8_t qs[64]    (2-bit levels, 4 per byte)
//   bytes  96..107   uint8_t scales[12] (16 x 6-bit packed int8 scales)
//   bytes 108..109   f16 d
// Dequant (canonical ggml dequantize_row_q3_K):
//   hcut = lane>>7, pos = lane&127, j = pos>>5, l = pos&31,
//   hi = l>>4, ll = l&15, is = hcut*8 + j*2 + hi, shift = 2*j
//   q2   = (qs[hcut*32 + ll + hi*16] >> shift) & 3
//   hb   = (hmask[ll + hi*16] >> (j + hcut*4)) & 1
//   level = q2 - (hb ? 0 : 4)
//   16 x int8 scales recovered from the 12 raw bytes:
//     is<4:  (s[is]&0xF) | ((s[8+is]&3)<<4)
//     is<8:  (s[is]&0xF) | (((s[is+4]>>2)&3)<<4)
//     is<12: (s[is-8]>>4) | (((s[is]>>4)&3)<<4)
//     else:  (s[is-8]>>4) | (((s[is]>>6)&3)<<4)
//   out = d * (sc8 - 32) * level
//
// x is the f32 activation matrix (k x pc.n), column-major.
// y is the output (pc.m x pc.n), column-major.
// pc.m = weight rows, pc.n = activation cols. pc.lda = row byte stride (ldw).

// Specialization constants
layout(constant_id = 0) const uint TILE_M = 16;
layout(constant_id = 1) const uint TILE_N = 16;
layout(constant_id = 2) const uint TILE_K = 16;

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufW { uint8_t data_W[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufX { float data_X[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufY { float data_Y[]; };
layout(set = 0, binding = 3) writeonly  buffer BufZ { float data_Z[]; };

shared float As[TILE_M * TILE_K];
shared float Bs[TILE_K * TILE_N];

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uint row = gl_LocalInvocationID.x;
    uint col = gl_LocalInvocationID.y;

    uint grRow = gl_WorkGroupID.x;
    uint grCol = gl_WorkGroupID.y;

    uint globalRow = grRow * TILE_M + row;   /* weight row (0..pc.m)   */
    uint globalCol = grCol * TILE_N + col;   /* activation col (0..pc.n) */

    float acc = 0.0;
    uint numTiles = (pc.k + TILE_K - 1) / TILE_K;

    for (uint t = 0; t < numTiles; ++t) {
        // ── Load W tile (TILE_M rows x TILE_K cols), dequantizing Q3_K ──
        for (uint a_col = col; a_col < TILE_K; a_col += TILE_N) {
            uint aRow = globalRow;
            uint kk   = t * TILE_K + a_col;            /* global k index  */
            uint block = kk / 256u;                    /* block in row    */
            uint lane  = kk & 255u;                    /* element in block */
            uint base  = aRow * pc.lda + block * 110u; /* block byte base */

            float val = 0.0f;
            if (aRow < pc.m && kk < pc.k) {
                uint d_bits = uint(data_W[base + 108u]) | (uint(data_W[base + 109u]) << 8u);
                float d = unpackHalf2x16(d_bits).x;

                uint hcut = lane >> 7u;          /* 0..1                    */
                uint pos  = lane & 127u;
                uint j    = pos >> 5u;           /* 0..3                    */
                uint l    = pos & 31u;
                uint hi   = l >> 4u;             /* 0: elems 0..15, 1: 16..31 */
                uint ll   = l & 15u;

                uint is    = hcut * 8u + j * 2u + hi;
                uint shift = 2u * j;
                uint mbit  = j + (hcut != 0u ? 4u : 0u);
                uint q_off = hcut * 32u + ll + (hi != 0u ? 16u : 0u);
                uint h_off = ll + (hi != 0u ? 16u : 0u);

                uint q2 = (uint(data_W[base + 32u + q_off]) >> shift) & 3u;
                uint hb = (uint(data_W[base + h_off]) >> mbit) & 1u;
                int  level = int(q2) - ((hb != 0u) ? 0 : 4);

                uint s_off = base + 96u;
                uint s0, s1;
                if (is < 4u) {
                    s0 = uint(data_W[s_off + is]) & 0xFu;
                    s1 = uint(data_W[s_off + 8u + is]) & 3u;
                } else if (is < 8u) {
                    s0 = uint(data_W[s_off + is]) & 0xFu;
                    s1 = (uint(data_W[s_off + is + 4u]) >> 2u) & 3u;
                } else if (is < 12u) {
                    s0 = uint(data_W[s_off + is - 8u]) >> 4u;
                    s1 = (uint(data_W[s_off + is]) >> 4u) & 3u;
                } else {
                    s0 = uint(data_W[s_off + is - 8u]) >> 4u;
                    s1 = (uint(data_W[s_off + is - 4u]) >> 6u) & 3u;
                }
                int sc = int(s0 | (s1 << 4u)) - 32;

                val = d * float(sc) * float(level);
            }
            As[row * TILE_K + a_col] = val;
        }

        // ── Load x tile (TILE_K rows x TILE_N cols) ─────────────────────
        for (uint b_row = row; b_row < TILE_K; b_row += TILE_M) {
            uint bRow = t * TILE_K + b_row;
            uint bCol = globalCol;
            bool in_bounds = (bRow < pc.k) && (bCol < pc.n);
            uint idx = bRow + bCol * pc.ldb;
            Bs[b_row * TILE_N + col] = in_bounds ? data_X[idx] : 0.0f;
        }

        barrier();

        // ── Compute: acc += sum_k As[row, kk] * Bs[kk, col] ──────────────
        for (uint kk = 0; kk < TILE_K; ++kk) {
            acc += As[row * TILE_K + kk] * Bs[kk * TILE_N + col];
        }

        barrier();
    }

    // ── Scale and write (guard tiles that overhang m/n) ──────────────────
    if (globalRow >= pc.m || globalCol >= pc.n) { return; }

    float result = pc.alpha * acc;

    if (pc.beta_is_zero == 0) {
        uint cIdx = globalRow + globalCol * pc.ldc;
        result += pc.beta * data_Y[cIdx];
    }

    uint dIdx = globalRow + globalCol * pc.ldd;
    data_Z[dIdx] = result;
}
