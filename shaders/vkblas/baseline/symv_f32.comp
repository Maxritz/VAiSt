#version 450

/**
 * \file symv_f32.comp
 * \brief Symmetric matrix-vector product (BLAS Level 2):  y = alpha * A * x + beta * y
 *
 * Reads only the authoritative triangle of A and mirrors the off-diagonal
 * contributions to both y[i] and y[j]. Column-major layout.
 *
 * Field mapping:
 *   pc.m      = n (A is n x n; x is n)
 *   pc.lda    = leading dim of A
 *   pc.transB = uplo: 0 lower, 1 upper (which triangle of A to read)
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint n     = pc.m;
    const uint i     = gl_GlobalInvocationID.x;
    const uint batch = gl_GlobalInvocationID.y;
    if (i >= n) return;
    const bool readLower = (pc.transB == 0);
    const uint aOff = batch * pc.strideA;
    const uint xOff = batch * pc.strideB;
    const uint yOff = batch * pc.strideC;
    const uint dOff = batch * pc.strideD;

    float acc = 0.0;
    for (uint j = 0; j < n; ++j) {
        /* Read A[i,j] only from the authoritative triangle. */
        float a_ij;
        if (readLower)
            a_ij = (i >= j) ? data_A[aOff + i + j * pc.lda]
                            : data_A[aOff + j + i * pc.lda];
        else
            a_ij = (j >= i) ? data_A[aOff + i + j * pc.lda]
                            : data_A[aOff + j + i * pc.lda];
        acc += a_ij * data_B[xOff + j];
    }
    float y_i = (pc.beta_is_zero == 1) ? 0.0 : data_C[yOff + i];
    data_D[dOff + i] = pc.alpha * acc + pc.beta * y_i;
}
