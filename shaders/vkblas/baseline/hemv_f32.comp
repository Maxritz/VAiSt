#version 450

/**
 * \file hemv_f32.comp
 * \brief Hermitian matrix-vector product: y = alpha * A * x + beta * y.
 *
 * On real-valued (f32) storage hemv is identical to symv; the field mapping
 * is kept distinct so a complex A can be added without changing the push
 * constant block.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint n     = pc.m;
    const uint i     = gl_GlobalInvocationID.x;
    const uint batch = gl_GlobalInvocationID.y;
    if (i >= n) return;
    const bool readLower = (pc.transB == 0);
    const uint aOff = batch * pc.strideA;
    const uint xOff = batch * pc.strideB;
    const uint yOff = batch * pc.strideC;
    const uint dOff = batch * pc.strideD;

    float acc = 0.0;
    for (uint j = 0; j < n; ++j) {
        float a_ij;
        if (readLower)
            a_ij = (i >= j) ? data_A[aOff + i + j * pc.lda]
                            : data_A[aOff + j + i * pc.lda];
        else
            a_ij = (j >= i) ? data_A[aOff + i + j * pc.lda]
                            : data_A[aOff + j + i * pc.lda];
        acc += a_ij * data_B[xOff + j];
    }
    float y_i = (pc.beta_is_zero == 1) ? 0.0 : data_C[yOff + i];
    data_D[dOff + i] = pc.alpha * acc + pc.beta * y_i;
}
