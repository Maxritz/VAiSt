#version 450

/**
 * \file herk_f32.comp
 * \brief Hermitian rank-k update: C = alpha * op(A) * op(A)^T + beta * C.
 *
 * On f32 storage herk is identical to syrk (no conjugation support in this
 * baseline tier, mirroring the rocBLAS real-valued specialisation);
 * the field mapping is documented so that a future complex variant can
 * extend this shader without breaking the push-constant block.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    const uint n = pc.m;
    const uint k = pc.k;
    const bool fillLower = (pc.transB == 0);
    const bool aIsNbyK   = (pc.transA == 0);
    const uint batch = gl_WorkGroupID.z;
    const uint aOff  = batch * pc.strideA;
    const uint cOff  = batch * pc.strideC;
    const uint dOff  = batch * pc.strideD;

    const uint i = gl_WorkGroupID.y * 16 + gl_LocalInvocationID.y;
    const uint j = gl_WorkGroupID.x * 16 + gl_LocalInvocationID.x;
    if (i >= n || j >= n) return;

    bool inAuthLower = (i > j);
    bool isDiagonal = (i == j);
    if (!isDiagonal && fillLower != inAuthLower) return;

    float acc = 0.0;
    for (uint p = 0; p < k; ++p) {
        float a_ip = aIsNbyK ? data_A[aOff + i + p * pc.lda]
                             : data_A[aOff + p + i * pc.lda];
        float a_jp = aIsNbyK ? data_A[aOff + j + p * pc.lda]
                             : data_A[aOff + p + j * pc.lda];
        acc += a_ip * a_jp;
    }

    float c_ij = (pc.beta_is_zero == 1) ? 0.0 : data_C[cOff + j * pc.ldc + i];
    float res  = pc.alpha * acc + pc.beta * c_ij;
    data_D[dOff + j * pc.ldd + i] = res;
    if (i != j) data_D[dOff + i * pc.ldd + j] = res;
}
