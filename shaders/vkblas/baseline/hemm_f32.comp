#version 450

/**
 * \file hemm_f32.comp
 * \brief Hermitian matrix-matrix product: C = alpha * A * B + beta * C.
 *
 * Real-valued on f32 storage (matches the symm numerics); the same shader
 * can later be reused for complex A by extending the field mapping.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    const uint n_dim = pc.m;
    const uint k_dim = pc.k;
    const bool readLower = (pc.transB == 0);
    const uint batch = gl_WorkGroupID.z;
    const uint aOff  = batch * pc.strideA;
    const uint bOff  = batch * pc.strideB;
    const uint cOff  = batch * pc.strideC;
    const uint dOff  = batch * pc.strideD;

    const uint i = gl_WorkGroupID.y * 16 + gl_LocalInvocationID.y;
    const uint j = gl_WorkGroupID.x * 16 + gl_LocalInvocationID.x;
    if (i >= n_dim || j >= k_dim) return;

    float acc = 0.0;
    for (uint p = 0; p < n_dim; ++p) {
        float a_ip;
        if (readLower)
            a_ip = (i >= p) ? data_A[aOff + i + p * pc.lda]
                            : data_A[aOff + p + i * pc.lda];
        else
            a_ip = (p >= i) ? data_A[aOff + i + p * pc.lda]
                            : data_A[aOff + p + i * pc.lda];
        acc += a_ip * data_B[bOff + p + j * pc.ldb];
    }
    float c_ij = (pc.beta_is_zero == 1) ? 0.0 : data_C[cOff + i + j * pc.ldc];
    data_D[dOff + i + j * pc.ldd] = pc.alpha * acc + pc.beta * c_ij;
}
