#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_float16 : enable
#extension GL_EXT_scalar_block_layout : enable

/**
 * \file symm_f16.comp
 * \brief f16 variant of symm: C = alpha * A * B + beta * C, A symmetric on the left.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufA { float16_t data_A[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufB { float16_t data_B[]; };
layout(scalar, set = 0, binding = 2) restrict readonly buffer BufC { float16_t data_C[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufD { float16_t data_D[]; };

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    const uint n_dim = pc.m;
    const uint k_dim = pc.k;
    const bool readLower = (pc.transB == 0);
    const uint batch = gl_WorkGroupID.z;
    const uint aOff  = batch * pc.strideA;
    const uint bOff  = batch * pc.strideB;
    const uint cOff  = batch * pc.strideC;
    const uint dOff  = batch * pc.strideD;

    const uint i = gl_WorkGroupID.y * 16 + gl_LocalInvocationID.y;
    const uint j = gl_WorkGroupID.x * 16 + gl_LocalInvocationID.x;
    if (i >= n_dim || j >= k_dim) return;

    float acc = 0.0;
    for (uint p = 0; p < n_dim; ++p) {
        float a_ip;
        if (readLower)
            a_ip = (i >= p) ? float(data_A[aOff + i + p * pc.lda])
                            : float(data_A[aOff + p + i * pc.lda]);
        else
            a_ip = (p >= i) ? float(data_A[aOff + i + p * pc.lda])
                            : float(data_A[aOff + p + i * pc.lda]);
        acc += a_ip * float(data_B[bOff + p + j * pc.ldb]);
    }
    float c_ij = (pc.beta_is_zero == 1) ? 0.0 : float(data_C[cOff + i + j * pc.ldc]);
    data_D[dOff + i + j * pc.ldd] = float16_t(pc.alpha * acc + pc.beta * c_ij);
}
