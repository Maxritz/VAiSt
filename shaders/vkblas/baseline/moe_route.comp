#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// MoE routing shim: top-k gate dispatch (mirrors FreeToken moe.cuh + ATOM
// atom/attention/flash_deciding.py).  Fused with vecdot for gate scoring only;
// the per-expert matmul body reuses the existing qgemm_* shaders.
//
// One invocation per input row. For row r with k features:
//   score[e] = dot(x_r, gate_e)     // gate_e = x[k*neg...k*neg+15]... gate is (num_experts x k_gate)
//   top = argmax(score)             // top-1; top-k via repeated max+mask for k>1
//   out_indices[r] = top
//   out_weights[r] = score[top]      // unnormalized; host softmaxes
//
// Push constants and descriptor layout match VKBLAS convention (bindings 0..3),
// but binding semantics are repurposed:
//   binding 0 = X  (input activations, m x k)
//   binding 1 = G  (gate matrix, num_experts x k_gate)
//   binding 2 = (unused)
//   binding 3 = OUT (indices + scores, 2 x m)

layout(push_constant) uniform PC {
    uint  m;          // number of input rows
    uint  k;          // activation feature dim
    uint  k_gate;     // gate weight feature dim
    uint  num_experts;
    uint  top_k;      // =1 for now (top-1 routing)
    uint  ldx;        // stride of X (row-major: x + r*ldx)
    uint  ldg;        // stride of G (row-major: g + e*ldg)
    uint  _pad0;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufX { float data_X[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufG { float data_G[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufOut { uint  data_idx[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufScore { float data_score[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.m) return;

    float best_score = -1e30f;
    uint best_e = 0u;

    for (uint e = 0u; e < pc.num_experts; ++e) {
        float dot = 0.0f;
        uint gbase = e * pc.ldg;
        uint xbase = r * pc.ldx;
        uint k_loop = min(pc.k_gate, pc.k);
        for (uint p = 0u; p < k_loop; ++p) {
            dot += data_X[xbase + p] * data_G[gbase + p];
        }
        if (dot > best_score) {
            best_score = dot;
            best_e = e;
        }
    }

    data_idx[r]   = best_e;
    data_score[r]  = best_score;
}
