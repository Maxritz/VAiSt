#version 450

/**
 * \file trsm_f32.comp
 * \brief Triangular solve for matrices (BLAS Level 3):  op(A) * X = alpha * B
 *
 * One workgroup per RHS column of B. Each workgroup runs one sequential
 * forward/back substitution over the n equations for that column.
 * Column-major layout matching rocBLAS.
 *
 * Field mapping (reuses the shared vkblas push-constant block):
 *   pc.m      = n    (A is n x n; B is n x nrhs)
 *   pc.n      = nrhs (number of RHS columns in B)
 *   pc.lda    = leading dim of A, pc.ldb = leading dim of B
 *   pc.ldd    = leading dim of X output (in-place into BufD)
 *   pc.transA = 0 normal, 1 transpose
 *   pc.transB = uplo: 0 lower, 1 upper
 *   pc._pad0  = diag: 0 non-unit, 1 unit
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) buffer BufD { float data_D[]; };   /* read/write: in-out X */

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint n    = pc.m;
    const uint rhs  = gl_WorkGroupID.y;          /* which column of B */
    const uint batch = gl_WorkGroupID.x;
    const bool lowerA   = (pc.transB == 0);
    const bool unitDiag = (pc._pad0 == 1);

    const uint aOff = batch * pc.strideA;
    const uint bOff = batch * pc.strideB + rhs * pc.ldb;
    const uint xOff = batch * pc.strideD + rhs * pc.ldd;

    for (uint i = 0; i < n; ++i)
        data_D[xOff + i] = pc.alpha * data_B[bOff + i];

    if (pc.transA == 0) {
        if (lowerA) {
            for (uint i = 0; i < n; ++i) {
                float sum = data_D[xOff + i];
                for (uint j = 0; j < i; ++j)
                    sum -= data_A[aOff + i + j * pc.lda] * data_D[xOff + j];
                float diag = unitDiag ? 1.0 : data_A[aOff + i + i * pc.lda];
                data_D[xOff + i] = sum / diag;
            }
        } else {
            for (int ii = int(n) - 1; ii >= 0; --ii) {
                uint i = uint(ii);
                float sum = data_D[xOff + i];
                for (uint j = i + 1; j < n; ++j)
                    sum -= data_A[aOff + i + j * pc.lda] * data_D[xOff + j];
                float diag = unitDiag ? 1.0 : data_A[aOff + i + i * pc.lda];
                data_D[xOff + i] = sum / diag;
            }
        }
    } else {
        if (lowerA) {
            for (int ii = int(n) - 1; ii >= 0; --ii) {
                uint i = uint(ii);
                float sum = data_D[xOff + i];
                for (uint j = i + 1; j < n; ++j)
                    sum -= data_A[aOff + j + i * pc.lda] * data_D[xOff + j];
                float diag = unitDiag ? 1.0 : data_A[aOff + i + i * pc.lda];
                data_D[xOff + i] = sum / diag;
            }
        } else {
            for (uint i = 0; i < n; ++i) {
                float sum = data_D[xOff + i];
                for (uint j = 0; j < i; ++j)
                    sum -= data_A[aOff + j + i * pc.lda] * data_D[xOff + j];
                float diag = unitDiag ? 1.0 : data_A[aOff + i + i * pc.lda];
                data_D[xOff + i] = sum / diag;
            }
        }
    }
}
