#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_float16 : enable
#extension GL_EXT_scalar_block_layout : enable

/**
 * \file syrk_f16.comp
 * \brief f16 variant of syrk: C = alpha * op(A) * op(A)^T + beta * C.
 */

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufA { float16_t data_A[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufB { float16_t data_B[]; };
layout(scalar, set = 0, binding = 2) restrict readonly buffer BufC { float16_t data_C[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufD { float16_t data_D[]; };

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    const uint n = pc.m;
    const uint k = pc.k;
    const bool fillLower = (pc.transB == 0);
    const bool aIsNbyK   = (pc.transA == 0);
    const uint batch = gl_WorkGroupID.z;
    const uint aOff  = batch * pc.strideA;
    const uint cOff  = batch * pc.strideC;
    const uint dOff  = batch * pc.strideD;

    const uint i = gl_WorkGroupID.y * 16 + gl_LocalInvocationID.y;
    const uint j = gl_WorkGroupID.x * 16 + gl_LocalInvocationID.x;
    if (i >= n || j >= n) return;

    bool inAuthLower = (i > j);
    bool isDiagonal = (i == j);
    if (!isDiagonal && fillLower != inAuthLower) return;

    float acc = 0.0;
    for (uint p = 0; p < k; ++p) {
        float a_ip = aIsNbyK ? float(data_A[aOff + i + p * pc.lda])
                             : float(data_A[aOff + p + i * pc.lda]);
        float a_jp = aIsNbyK ? float(data_A[aOff + j + p * pc.lda])
                             : float(data_A[aOff + p + j * pc.lda]);
        acc += a_ip * a_jp;
    }

    float c_ij = (pc.beta_is_zero == 1) ? 0.0 : float(data_C[cOff + j * pc.ldc + i]);
    float res  = pc.alpha * acc + pc.beta * c_ij;
    data_D[dOff + j * pc.ldd + i] = float16_t(res);
    if (i != j) data_D[dOff + i * pc.ldd + j] = float16_t(res);
}
