#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_cooperative_matrix : enable

// Fused coopmatrix quantized GEMM (fp16 output): y = alpha * (dequant_q3k(W) * x) + beta * y.
//
// Q3_K block: 110 B/block of 256 elems (ggml block_q3_K).
// out = d*sc*level

layout(constant_id = 0) const uint TILE_M   = 16;
layout(constant_id = 1) const uint TILE_N   = 16;
layout(constant_id = 2) const uint TILE_K   = 16;
layout(constant_id = 3) const uint SG_WIDTH = 32;

#define CM_M 16
#define CM_N 16
#define CM_K 16
#define CM_SCOPE   3
#define CM_USE_A   0
#define CM_USE_B   1
#define CM_USE_ACC 2

layout(push_constant) uniform PC {
    uint  m, n, k;
    float alpha, beta;
    uint  lda, ldb, ldc, ldd;
    int   transA, transB, beta_is_zero, _pad0;
    uint  strideA, strideB, strideC, strideD;
    uint  batchCount, _pad1, _pad2, _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufW { uint8_t data_W[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufX { float data_X[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufY { float16_t data_Y[]; };
layout(set = 0, binding = 3) writeonly  buffer BufZ { float16_t data_Z[]; };

shared float As[CM_M * CM_K];
shared float Bs[CM_K * CM_N];
shared float Ds[CM_M * CM_N];

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

coopmat<float, CM_SCOPE, CM_M, CM_K, CM_USE_A>  a_frag;
coopmat<float, CM_SCOPE, CM_K, CM_N, CM_USE_B>  b_frag;
coopmat<float, CM_SCOPE, CM_M, CM_N, CM_USE_ACC> acc_frag;

void main() {
    uint lane   = gl_LocalInvocationIndex;
    uint grRow  = gl_WorkGroupID.x;
    uint grCol  = gl_WorkGroupID.y;
    uint batch  = gl_WorkGroupID.z;

    uint globalRow0 = grRow * CM_M;
    uint globalCol0 = grCol * CM_N;

    uint numTiles = (pc.k + CM_K - 1) / CM_K;

    for (uint t = 0; t < numTiles; ++t) {
        for (uint i = lane; i < CM_M * CM_K; i += SG_WIDTH) {
            uint r   = i / CM_K;
            uint c   = i % CM_K;
            uint aRow = globalRow0 + r;
            uint aCol = t * CM_K + c;

            float val = 0.0f;
            if (aRow < pc.m && aCol < pc.k) {
                uint kk     = aCol;
                uint block  = kk / 256u;
                uint lane2  = kk & 255u;
                uint base   = aRow * pc.lda + block * 110u;

                uint d_bits = uint(data_W[base + 108u]) | (uint(data_W[base + 109u]) << 8u);
                float d = unpackHalf2x16(d_bits).x;

                uint hcut = lane2 >> 7u;
                uint pos  = lane2 & 127u;
                uint j    = pos >> 5u;
                uint l    = pos & 31u;
                uint hi   = l >> 4u;
                uint ll   = l & 15u;

                uint is    = hcut * 8u + j * 2u + hi;
                uint shift = 2u * j;
                uint mbit  = j + (hcut != 0u ? 4u : 0u);
                uint q_off = hcut * 32u + ll + (hi != 0u ? 16u : 0u);
                uint h_off = ll + (hi != 0u ? 16u : 0u);

                uint q2 = (uint(data_W[base + 32u + q_off]) >> shift) & 3u;
                uint hb = (uint(data_W[base + h_off]) >> mbit) & 1u;
                int  level = int(q2) - ((hb != 0u) ? 0 : 4);

                uint s_off = base + 96u;
                uint s0, s1;
                if (is < 4u) {
                    s0 = uint(data_W[s_off + is]) & 0xFu;
                    s1 = uint(data_W[s_off + 8u + is]) & 3u;
                } else if (is < 8u) {
                    s0 = uint(data_W[s_off + is]) & 0xFu;
                    s1 = (uint(data_W[s_off + is + 4u]) >> 2u) & 3u;
                } else if (is < 12u) {
                    s0 = uint(data_W[s_off + is - 8u]) >> 4u;
                    s1 = (uint(data_W[s_off + is]) >> 4u) & 3u;
                } else {
                    s0 = uint(data_W[s_off + is - 8u]) >> 4u;
                    s1 = (uint(data_W[s_off + is - 4u]) >> 6u) & 3u;
                }
                int sc = int(s0 | (s1 << 4u)) - 32;

                val = d * float(sc) * float(level);
            }
            As[i] = val;
        }

        for (uint i = lane; i < CM_K * CM_N; i += SG_WIDTH) {
            uint r   = i / CM_N;
            uint c   = i % CM_N;
            uint bRow = t * CM_K + r;
            uint bCol = globalCol0 + c;

            bool in_k = bRow < pc.k;
            bool in_n = bCol < pc.n;
            Bs[i] = (in_k && in_n) ? data_X[bRow + bCol * pc.ldb + batch * pc.strideB] : 0.0f;
        }

        barrier();

        coopMatLoad(a_frag, As, 0, CM_K, 0);
        coopMatLoad(b_frag, Bs, 0, CM_N, 0);
        acc_frag = coopMatMulAdd(a_frag, b_frag, acc_frag);

        barrier();
    }

    coopMatStore(acc_frag, Ds, 0, CM_N, 0);
    barrier();

    for (uint i = lane; i < CM_M * CM_N; i += SG_WIDTH) {
        uint r = i / CM_N;
        uint c = i % CM_N;

        uint globalRow = globalRow0 + r;
        uint globalCol = globalCol0 + c;

        if (globalRow >= pc.m || globalCol >= pc.n) { continue; }

        float result = pc.alpha * Ds[i];

        if (pc.beta_is_zero == 0) {
            uint cIdx = globalRow + globalCol * pc.ldc + batch * pc.strideC;
            result += pc.beta * data_Y[cIdx];
        }

        uint dIdx = globalRow + globalCol * pc.ldd + batch * pc.strideD;
        data_Z[dIdx] = float16_t(result);
    }
}
