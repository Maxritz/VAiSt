#version 450

#extension GL_KHR_cooperative_matrix : enable

// ────────────────────────────────────────────────────────────────────────────
// Tier 2 f32 GEMM.
//
// NOTE ON THE REAL COOP-MATRIX PATH: A genuine GL_KHR_cooperative_matrix
// implementation (coopmat<float,16,16,16,use> fragments via coopMatLoadKHR /
// coopMatMulAddKHR / coopMatStoreKHR, 16x16x16 f32 fragments, staged through
// per-subgroup shared memory, subgroup-tiled workgroups) was written, and it
// compiles cleanly with glslangValidator to SPIR-V carrying the
// CooperativeMatrixKHR capability. However, the AMD Windows driver 26.7.1 on
// RDNA2 (RX 6700 XT) CRASHES the process (0xE06D7363) inside
// vkCreateComputePipelines when compiling ANY shader module that contains the
// coopMatMulAddKHR instruction, despite advertising VK_KHR_cooperative_matrix
// rev 2 + a f32 16x16x16 fragment. This is a driver-side failure that cannot
// be caught with a VkResult, so the real path cannot be shipped without
// breaking the GPU it runs on.
//
// Per root AGENTS.md ("every feature must have a Vulkan approximation") the
// coopmatrix tier keeps the portable shared-memory fallback below. The kernel
// is numerically identical to the baseline/subgroup tiers; only the tier name
// differs. When a driver that actually executes coopMatMulAddKHR is available
// (e.g. RDNA4 with a fixed driver), re-enable the real fragment path.
// ────────────────────────────────────────────────────────────────────────────

// Specialization constants
layout(constant_id = 0) const uint TILE_M     = 16;
layout(constant_id = 1) const uint TILE_N     = 16;
layout(constant_id = 2) const uint CM_MSIZE   = 16;
layout(constant_id = 3) const uint CM_NSIZE   = 16;
layout(constant_id = 4) const uint CM_KSIZE   = 16;

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { float data_A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufB { float data_B[]; };
layout(set = 0, binding = 2) restrict readonly buffer BufC { float data_C[]; };
layout(set = 0, binding = 3) writeonly  buffer BufD { float data_D[]; };

shared float As[TILE_M * CM_KSIZE];
shared float Bs[CM_KSIZE * TILE_N];

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uint row  = gl_LocalInvocationID.x;
    uint col  = gl_LocalInvocationID.y;

    uint grRow = gl_WorkGroupID.x;
    uint grCol = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;

    uint globalRow = grRow * TILE_M + row;
    uint globalCol = grCol * TILE_N + col;

    float acc = 0.0;
    uint numTiles = (pc.k + CM_KSIZE - 1) / CM_KSIZE;

    for (uint t = 0; t < numTiles; ++t) {
        // ── Load A tile (TILE_M rows x CM_KSIZE cols) into shared memory ──
        for (uint a_col = col; a_col < CM_KSIZE; a_col += TILE_N) {
            uint aRow, aCol;
            if (pc.transA == 0) {
                aRow = globalRow;
                aCol = t * CM_KSIZE + a_col;
            } else {
                aRow = t * CM_KSIZE + a_col;
                aCol = globalRow;
            }
            uint idx = aRow + uint(aCol) * pc.lda + batch * pc.strideA;
            bool in_k = (pc.transA == 0) ? (aCol < pc.k) : (aRow < pc.k);
            As[row * CM_KSIZE + a_col] = in_k ? data_A[idx] : 0.0f;
        }

        // ── Load B tile (CM_KSIZE rows x TILE_N cols) into shared memory ──
        for (uint b_row = row; b_row < CM_KSIZE; b_row += TILE_M) {
            uint bRow, bCol;
            if (pc.transB == 0) {
                bRow = t * CM_KSIZE + b_row;
                bCol = globalCol;
            } else {
                bRow = globalCol;
                bCol = t * CM_KSIZE + b_row;
            }
            uint idx = bRow + uint(bCol) * pc.ldb + batch * pc.strideB;
            bool in_k = (pc.transB == 0) ? (bRow < pc.k) : (bCol < pc.k);
            Bs[b_row * TILE_N + col] = in_k ? data_B[idx] : 0.0f;
        }

        barrier();

        // ── Compute: acc += sum_k As[row,kk] * Bs[kk,col] ────────────────
        for (uint kk = 0; kk < CM_KSIZE; ++kk) {
            float a_val = As[row * CM_KSIZE + kk];
            float b_val = Bs[kk * TILE_N + col];
            acc += a_val * b_val;
        }

        barrier();
    }

    // ── Scale and write (guard tiles that overhang m/n) ───────────────────
    if (globalRow >= pc.m || globalCol >= pc.n) { return; }

    float result = pc.alpha * acc;

    if (pc.beta_is_zero == 0) {
        uint cIdx = globalRow + globalCol * pc.ldc + batch * pc.strideC;
        result += pc.beta * data_C[cIdx];
    }

    uint dIdx = globalRow + globalCol * pc.ldd + batch * pc.strideD;
    data_D[dIdx] = result;
}
