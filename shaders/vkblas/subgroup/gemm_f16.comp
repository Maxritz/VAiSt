#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_float16 : enable
#extension GL_EXT_scalar_block_layout : enable

// Specialization constants
layout(constant_id = 0) const uint TILE_M = 16;
layout(constant_id = 1) const uint TILE_N = 16;
layout(constant_id = 2) const uint TILE_K = 16;

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

// f16 storage, f32 accumulation: A/B/C/D are float16_t, tiles staged as float.
layout(scalar, set = 0, binding = 0) restrict readonly buffer BufA { float16_t data_A[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufB { float16_t data_B[]; };
layout(scalar, set = 0, binding = 2) restrict readonly buffer BufC { float16_t data_C[]; };
layout(scalar, set = 0, binding = 3) writeonly  buffer BufD { float16_t data_D[]; };

shared float As[TILE_M * TILE_K];
shared float Bs[TILE_K * TILE_N];

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uint row = gl_LocalInvocationID.x;
    uint col = gl_LocalInvocationID.y;

    uint grRow = gl_WorkGroupID.x;
    uint grCol = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;

    uint globalRow = grRow * TILE_M + row;
    uint globalCol = grCol * TILE_N + col;

    float acc = 0.0;
    uint numTiles = (pc.k + TILE_K - 1) / TILE_K;

    for (uint t = 0; t < numTiles; ++t) {
        // ── Load A tile (TILE_M rows × TILE_K cols) ─────────────────────
        for (uint a_col = col; a_col < TILE_K; a_col += TILE_N) {
            uint aRow, aCol;
            if (pc.transA == 0) {
                aRow = globalRow;
                aCol = t * TILE_K + a_col;
            } else {
                aRow = t * TILE_K + a_col;
                aCol = globalRow;
            }
            uint idx = aRow + aCol * pc.lda + batch * pc.strideA;
            bool in_k = (pc.transA == 0) ? (aCol < pc.k) : (aRow < pc.k);
            As[row * TILE_K + a_col] = in_k ? float(data_A[idx]) : 0.0f;
        }

        // ── Load B tile (TILE_K rows × TILE_N cols) ─────────────────────
        for (uint b_row = row; b_row < TILE_K; b_row += TILE_M) {
            uint bRow, bCol;
            if (pc.transB == 0) {
                bRow = t * TILE_K + b_row;
                bCol = globalCol;
            } else {
                bRow = globalCol;
                bCol = t * TILE_K + b_row;
            }
            uint idx = bRow + bCol * pc.ldb + batch * pc.strideB;
            bool in_k = (pc.transB == 0) ? (bRow < pc.k) : (bCol < pc.k);
            Bs[b_row * TILE_N + col] = in_k ? float(data_B[idx]) : 0.0f;
        }

        barrier();

        // ── Compute: acc += sum_k As[row, kk] * Bs[kk, col] (f32) ───────
        for (uint kk = 0; kk < TILE_K; ++kk) {
            acc += As[row * TILE_K + kk] * Bs[kk * TILE_N + col];
        }

        barrier();
    }

    // ── Scale and write (guard tiles that overhang m/n) ──────────────────
    if (globalRow >= pc.m || globalCol >= pc.n) { return; }

    float result = pc.alpha * acc;

    if (pc.beta_is_zero == 0) {
        uint cIdx = globalRow + globalCol * pc.ldc + batch * pc.strideC;
        result += pc.beta * float(data_C[cIdx]);
    }

    uint dIdx = globalRow + globalCol * pc.ldd + batch * pc.strideD;
    data_D[dIdx] = float16_t(result);
}
