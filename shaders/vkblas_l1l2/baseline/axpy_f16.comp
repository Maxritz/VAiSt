#version 450

// BLAS Level 1 axpy (f16):  y = alpha * x + y   (in-place y)
// Halfs stored one-per-uint32 (low 16 bits).  alpha/beta are f32 host scalars.
// fp16 I/O uses integer bit-packing so no shaderFloat16 feature is required.
// binding 0 = x (read, uint),  binding 1 = y (read-write, uint).

// ── fp16 <-> f32 bit helpers (portable, no float16_t) ───────────────────────

uint f16_pack(float f) {
    uint fbits = floatBitsToUint(f);
    uint sign  = (fbits >> 16u) & 0x8000u;
    uint e32   = (fbits >> 23u) & 0xFFu;
    uint m32   = fbits & 0x7FFFFFu;

    if (e32 == 255u) { return sign | 0x7C00u; }       /* inf/nan -> inf */

    int e16 = int(e32) - 127 + 15;
    if (e16 >= 31) { return sign | 0x7C00u; }          /* overflow -> inf */
    if (e16 <= 0) {
        if (e16 < -10) { return sign; }                /* underflow -> 0  */
        uint m = m32 | 0x800000u;                      /* implicit 1 bit   */
        m = m >> uint(1 - e16);
        uint h = (m + 0x1000u) >> 13u;                 /* round to nearest */
        return sign | (h & 0x3FFu);
    }

    uint h = (uint(e16) << 10u) | (m32 >> 13u);
    uint rem = m32 & 0x1FFFu;
    if (rem > 0x1000u) { h += 1u; }
    else if (rem == 0x1000u && ((h & 1u) == 1u)) { h += 1u; }
    return sign | h;
}

float f16_unpack(uint u) {
    u &= 0xFFFFu;
    uint sign = (u >> 15u) & 1u;
    uint expo = (u >> 10u) & 0x1Fu;
    uint man  = u & 0x3FFu;

    float mag;
    if (expo == 0u) {
        mag = float(man) * (1.0 / 16777216.0);         /* man * 2^-24       */
    } else if (expo == 31u) {
        mag = 1.0e30;                                  /* inf/nan -> large  */
    } else {
        mag = (1.0 + float(man) / 1024.0) * exp2(float(int(expo)) - 15.0);
    }
    return sign != 0u ? -mag : mag;
}

// ── Push constants (matches vkblas_push_constants_t) ────────────────────────

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufX { uint x[]; };
layout(set = 0, binding = 1)          buffer BufY { uint y[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint ix = i * pc.lda;
    uint iy = i * pc.ldb;
    float xv = f16_unpack(x[ix]);
    float yv = f16_unpack(y[iy]);
    y[iy] = f16_pack(pc.alpha * xv + yv);
}
