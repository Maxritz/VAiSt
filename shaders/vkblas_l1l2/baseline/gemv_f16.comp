#version 450

// BLAS Level 2 gemv (f16):  y = alpha * op(A) * x + beta * y   (in-place y)
// Halfs stored one-per-uint32 (low 16 bits).  alpha/beta are f32 scalars.
// Column-major A with leading dimension lda.  One thread per output row.
// binding 0 = A (read, uint),  binding 1 = x (read, uint),
// binding 3 = y (read-write, uint).

uint f16_pack(float f) {
    uint fbits = floatBitsToUint(f);
    uint sign  = (fbits >> 16u) & 0x8000u;
    uint e32   = (fbits >> 23u) & 0xFFu;
    uint m32   = fbits & 0x7FFFFFu;

    if (e32 == 255u) { return sign | 0x7C00u; }
    int e16 = int(e32) - 127 + 15;
    if (e16 >= 31) { return sign | 0x7C00u; }
    if (e16 <= 0) {
        if (e16 < -10) { return sign; }
        uint m = m32 | 0x800000u;
        m = m >> uint(1 - e16);
        uint h = (m + 0x1000u) >> 13u;
        return sign | (h & 0x3FFu);
    }
    uint h = (uint(e16) << 10u) | (m32 >> 13u);
    uint rem = m32 & 0x1FFFu;
    if (rem > 0x1000u) { h += 1u; }
    else if (rem == 0x1000u && ((h & 1u) == 1u)) { h += 1u; }
    return sign | h;
}

float f16_unpack(uint u) {
    u &= 0xFFFFu;
    uint sign = (u >> 15u) & 1u;
    uint expo = (u >> 10u) & 0x1Fu;
    uint man  = u & 0x3FFu;
    float mag;
    if (expo == 0u) {
        mag = float(man) * (1.0 / 16777216.0);
    } else if (expo == 31u) {
        mag = 1.0e30;
    } else {
        mag = (1.0 + float(man) / 1024.0) * exp2(float(int(expo)) - 15.0);
    }
    return sign != 0u ? -mag : mag;
}

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufA { uint A[]; };
layout(set = 0, binding = 1) restrict readonly buffer BufX { uint x[]; };
layout(set = 0, binding = 3)          buffer BufY { uint y[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.m) { return; }

    float acc = 0.0;
    if (pc.transA == 0) {
        for (uint j = 0u; j < pc.n; j++) {
            acc += f16_unpack(A[row + j * pc.lda]) * f16_unpack(x[j * pc.ldb]);
        }
    } else {
        for (uint j = 0u; j < pc.n; j++) {
            acc += f16_unpack(A[j + row * pc.lda]) * f16_unpack(x[j * pc.ldb]);
        }
    }

    y[row * pc.ldd] = f16_pack(pc.alpha * acc + pc.beta * f16_unpack(y[row * pc.ldd]));
}
