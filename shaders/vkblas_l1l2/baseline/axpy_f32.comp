#version 450

// BLAS Level 1 axpy:  y = alpha * x + y   (in-place y)
// Thread-per-element.  n  = pc.n,  incx = pc.lda,  incy = pc.ldb (element strides).
// binding 0 = x (read),  binding 1 = y (read-write, in place).

layout(push_constant) uniform PC {
    uint  m;
    uint  n;
    uint  k;
    float alpha;
    float beta;
    uint  lda;
    uint  ldb;
    uint  ldc;
    uint  ldd;
    int   transA;
    int   transB;
    int   beta_is_zero;
    int   _pad0;
    uint  strideA;
    uint  strideB;
    uint  strideC;
    uint  strideD;
    uint  batchCount;
    uint  _pad1;
    uint  _pad2;
    uint  _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly buffer BufX { float x[]; };
layout(set = 0, binding = 1)          buffer BufY { float y[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint ix = i * pc.lda;
    uint iy = i * pc.ldb;
    y[iy] = pc.alpha * x[ix] + y[iy];
}
