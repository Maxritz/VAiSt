#version 450

// Cross-model KV cache transfer (arXiv:2608.03893): apply step.
//   dst[r][j] = sum_k src[r][k] * W_h[k][j]
// for r in [0, n), k in [0, src_dim), j in [0, tgt_dim).
//
// Buffer layouts (all row-major float32):
//   src  : [n x src_dim] -> src[r*src_dim + k]
//   dst  : [n x tgt_dim] -> dst[r*tgt_dim + j]
//   w    : [n_heads][src_dim*tgt_dim] stacked; the Wh block for head h starts
//          at element offset pc.w_offset = h*src_dim*tgt_dim, so
//          Wh[k][j] = w[w_offset + k*tgt_dim + j].
//
// RoPE stripping is the caller's responsibility (done before this shader runs).

layout(push_constant) uniform PC {
    uint num_elements;   // n * tgt_dim (total output elements)
    uint tgt_dim;        // target feature dimension per row
    uint src_dim;        // source feature dimension per row
    uint w_offset;       // element offset of Wh within the stacked W buffer
} pc;

layout(set = 0, binding = 0) restrict readonly  buffer BufSrc { float src[]; };
layout(set = 0, binding = 1) restrict readonly  buffer BufW   { float w[];   };
layout(set = 0, binding = 2)          writeonly buffer BufDst { float dst[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) { return; }

    uint j = i % pc.tgt_dim;
    uint r = i / pc.tgt_dim;

    float acc = 0.0f;
    uint wb = pc.w_offset + j;
    for (uint k = 0; k < pc.src_dim; k++) {
        acc += src[r * pc.src_dim + k] * w[wb + k * pc.tgt_dim];
    }
    dst[i] = acc;
}
