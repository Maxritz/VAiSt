#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Max reduction using subgroup operations.
// Input:  [num_rows * num_cols] (binding 0)
// Output: [num_rows]             (binding 2)

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly  buffer BufIn  { float data[]; };
layout(set = 0, binding = 2) writeonly           buffer BufOut { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared float row_max[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint slid = gl_SubgroupInvocationID;

    uint base = row * pc.num_cols;

    float val = -1.0e30;
    uint num_groups = (pc.num_cols + 31u) / 32u;
    for (uint g = 0u; g < num_groups; ++g) {
        uint col = g * 32u + slid;
        if (col < pc.num_cols) {
            val = max(val, data[base + col]);
        }
    }

    float sg_max = subgroupMax(val);

    if (gl_SubgroupInvocationID == 0u) {
        row_max[gl_SubgroupID] = sg_max;
    }
    barrier();

    if (gl_SubgroupID == 0u) {
        float final_max = -1.0e30;
        uint num_sgroups = gl_NumSubgroups;
        for (uint i = 0u; i < num_sgroups; ++i) {
            final_max = max(final_max, row_max[i]);
        }
        data_out[row] = final_max;
    }
}
