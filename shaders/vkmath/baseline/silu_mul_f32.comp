#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_scalar_block_layout : require

/**
 * Fused SiLU + multiply: out[i] = x[i] * sigmoid(x[i]) * y[i]
 *
 * Replaces: atom/model_ops/activation_ops.py:silu_mul, atom/models/llama.py:LlamaMLP.forward
 *
 * Bindings:
 *   set=0, binding=0: input X (f32, [num_elements_x])
 *   set=0, binding=1: input Y (f32, [num_elements_y]) — same count as X
 *   set=0, binding=2: output  (f32, [num_elements])
 *
 * Push constants:
 *   num_elements — total element count (X and Y are each this size)
 *   alpha        — unused (reserved for scaling)
 *   beta         — unused (reserved for scaling)
 */

layout(push_constant) uniform PC {
    uint   num_elements;
    uint   _pad0;
    float  alpha;
    float  beta;
    uint64_t _pad1;
    uint64_t _pad2;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufX   { float data_x[]; };
layout(scalar, set = 0, binding = 1) restrict readonly buffer BufY   { float data_y[]; };
layout(scalar, set = 0, binding = 2) writeonly buffer BufOut          { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;

    float x = data_x[idx];
    // SiLU(x) = x * sigmoid(x), numerically stable
    // sigmoid(x) = 1 / (1 + exp(-x))
    float sig = 1.0 / (1.0 + exp(-x));
    float silu = x * sig;
    float y = data_y[idx];

    data_out[idx] = silu * y;
}
