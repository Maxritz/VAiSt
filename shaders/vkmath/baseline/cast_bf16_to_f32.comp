#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Cast bf16 -> f32 (exact, matching gemm_bf16.comp):
//   out = uintBitsToFloat(uint(in) << 16)

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly buffer BufIn  { uint16_t data[]; };
layout(set = 0, binding = 2) writeonly                       buffer BufOut { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) { return; }

    data_out[idx] = uintBitsToFloat(uint(data[idx]) << 16);
}
