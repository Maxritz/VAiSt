#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// GELU (tanh approx) — f16 variant

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(scalar, set = 0, binding = 0) restrict readonly  buffer BufIn  { float16_t data[]; };
layout(scalar, set = 0, binding = 2) writeonly           buffer BufOut { float16_t data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) { return; }

    float16_t x = data[idx];
    const float16_t c1 = float16_t(0.044715);
    const float16_t c2 = float16_t(0.79788453); // sqrt(2/pi)
    float16_t inner = c2 * (x + c1 * x * x * x);
    float16_t t = float16_t(tanh(inner));
    data_out[idx] = float16_t(0.5) * x * (float16_t(1.0) + t);
}
