#version 450
#extension GL_ARB_gpu_shader_int64 : require

// Elementwise multiply: out = a * b

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly  buffer BufA   { float data_a[]; };
layout(set = 0, binding = 1) restrict readonly  buffer BufB   { float data_b[]; };
layout(set = 0, binding = 2) writeonly           buffer BufOut { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) { return; }

    data_out[idx] = data_a[idx] * data_b[idx];
}
