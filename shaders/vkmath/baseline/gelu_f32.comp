#version 450
#extension GL_ARB_gpu_shader_int64 : require

// GELU (tanh approximation):
//   out = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly  buffer BufIn  { float data[]; };
layout(set = 0, binding = 2) writeonly           buffer BufOut { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) { return; }

    float x = data[idx];
    const float c1 = 0.044715;
    const float c2 = 0.79788453; // sqrt(2/pi)
    float inner = c2 * (x + c1 * x * x * x);
    float t = tanh(inner);
    data_out[idx] = 0.5 * x * (1.0 + t);
}
