#version 450
#extension GL_ARB_gpu_shader_int64 : require

/**
 * \brief Batch normalization inference (NCHW, batch=1, per-channel params).
 *
 * Input:  [C, H, W]      (binding 0, SSBO float)
 * Stats:   [gamma[C], beta[C], mean[C], var[C]]  (binding 1, SSBO float)
 * Output: [C, H, W]      (binding 2, SSBO float)
 *
 * out = gamma * (x - mean) / sqrt(var + eps) + beta
 *
 * Push constant (std140, 32 bytes):
 *   h, w, channels, eps,
 *   scale_offset, bias_offset, mean_offset, var_offset
 */

layout(push_constant) uniform BNPC {
    uint  h;
    uint  w;
    uint  channels;
    float eps;
    uint  scale_offset;
    uint  bias_offset;
    uint  mean_offset;
    uint  var_offset;
} pc;

layout(set = 0, binding = 0) buffer BufIn  { float in_data[];  };
layout(set = 0, binding = 1) buffer BufSB  { float sb_data[];   };
layout(set = 0, binding = 2) buffer BufOut { float out_data[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint spatial_size = pc.h * pc.w;
    uint total = pc.channels * spatial_size;
    if (idx >= total) { return; }

    uint c = idx % pc.channels;
    uint hw = idx / pc.channels;

    float x = in_data[c * spatial_size + hw];

    float gamma = sb_data[pc.scale_offset + c];
    float beta  = sb_data[pc.bias_offset + c];
    float mean  = sb_data[pc.mean_offset + c];
    float var   = sb_data[pc.var_offset + c];

    float norm = (x - mean) / sqrt(var + pc.eps);
    out_data[c * spatial_size + hw] = gamma * norm + beta;
}
