#version 450
#extension GL_ARB_gpu_shader_int64 : require

// Inclusive prefix sum (cumsum) along each row:
// out[r][c] = sum_{i<=c} in[r][i]
// Input:  [num_rows * num_cols]  (binding 0)
// Output: [num_rows * num_cols]  (binding 2)
// Each workgroup handles one row. Blocks of <= 256 columns are scanned
// in shared memory with a Hillis-Steele inclusive scan; a running block
// offset carries the prefix across blocks for num_cols > 256.

layout(push_constant) uniform PC {
    uint  num_elements;
    uint  num_rows;
    uint  num_cols;
    float alpha;
    float beta;
    uint  _pad0;
    uint  _pad1;
    uint  _pad2;
    uint64_t stride_a;
    uint64_t stride_b;
    uint64_t stride_out;
    uint64_t batch_count;
    uint64_t _pad3;
} pc;

layout(set = 0, binding = 0) restrict readonly  buffer BufIn  { float data[]; };
layout(set = 0, binding = 2) writeonly           buffer BufOut { float data_out[]; };

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared float sdata[256];
shared float sblock_sum;

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = row * pc.num_cols;
    uint n = pc.num_cols;

    float running = 0.0;

    for (uint block = 0u; block < n; block += 256u) {
        uint len = min(256u, n - block);

        sdata[tid] = 0.0;
        if (tid < len) {
            sdata[tid] = data[base + block + tid];
        }
        barrier();

        // Hillis-Steele inclusive scan over the first `len` lanes.
        for (uint d = 1u; d < len; d <<= 1u) {
            float t = 0.0;
            if (tid >= d) {
                t = sdata[tid - d];
            }
            barrier();
            if (tid >= d) {
                sdata[tid] += t;
            }
            barrier();
        }

        if (tid == 0u) {
            sblock_sum = sdata[len - 1];
        }
        barrier();

        if (tid < len) {
            data_out[base + block + tid] = running + sdata[tid];
        }

        running += sblock_sum;
        barrier();
    }
}
